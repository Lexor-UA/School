rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for multi-tenancy and authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superAdmin' ||
        (hasUserData() && getUserData().role == 'superAdmin')
      );
    }

    function isOwner() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role == 'owner' ||
        (hasUserData() && getUserData().role == 'owner')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isOwner() ||
        request.auth.token.role == 'admin' ||
        (hasUserData() && getUserData().role == 'admin')
      );
    }

    function isCoach() {
      return isAuthenticated() && (
        request.auth.token.role == 'coach' ||
        (hasUserData() && getUserData().role == 'coach')
      );
    }

    function userBranch() {
      return (request.auth.token.branchId != null) ? request.auth.token.branchId :
        ((hasUserData() && getUserData().branchId != null) ? getUserData().branchId : 'kyiv');
    }

    function isStaffForBranch(branchId) {
      return isOwner() || (
        isAdmin() && (userBranch() == branchId || (branchId == null && userBranch() == 'kyiv'))
      );
    }

    // --- Organizations, Branches, and Configurations ---
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();

      match /branches/{branchId} {
        allow read: if isAuthenticated();
        allow write: if isOwner();
      }
    }

    match /branch_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    match /subscription_packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // --- Users (Clients, Coaches, Admins, Owners) ---
    match /users/{userId} {
      // Readable by authenticated users within system (coaches, parents, staff)
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        isStaffForBranch(resource.data.branchId)
      );

      allow delete: if isAuthenticated() && (
        isOwner() ||
        (isAdmin() && resource.data.role != 'owner' && resource.data.role != 'superAdmin' && resource.data.role != 'admin')
      );
    }

    // --- Children Profiles ---
    match /children/{childId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.parentId == request.auth.uid ||
        (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
        isAdmin() ||
        isCoach()
      );
    }

    // --- Schedule & Group Classes ---
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isStaffForBranch(request.resource.data.branchId) ||
        request.resource.data.isCustomBooking == true ||
        request.resource.data.createdByRole == 'parent'
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isStaffForBranch(resource.data.branchId) ||
        resource.data.isCustomBooking == true ||
        resource.data.createdByRole == 'parent'
      );
      // Update allowed for staff/coaches, or client enrolling/withdrawing (affecting enrolledChildIds and bookedSubscriptions)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isStaffForBranch(resource.data.branchId) ||
        isCoach() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledChildIds', 'bookedSubscriptions']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledChildIds']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendedChildIds'])
      );
    }

    // --- Subscriptions ---
    match /subscriptions/{subId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isStaffForBranch(resource.data.branchId) ||
        isCoach()
      );
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isStaffForBranch(request.resource.data.branchId) ||
        request.resource.data.userId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isStaffForBranch(resource.data.branchId) ||
        isCoach() ||
        resource.data.userId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isStaffForBranch(resource.data.branchId)
      );
    }

    // --- Payments & Invoicing ---
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        isAdmin() ||
        isStaffForBranch(resource.data.branchId)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.clientId == request.auth.uid ||
        isAdmin() ||
        isStaffForBranch(request.resource.data.branchId)
      );
      allow update, delete: if isAuthenticated() && isAdmin();
    }

    // --- Chat Dialogs & Messages ---
    match /chats/{dialogId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        dialogId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds)
      );

      allow create: if isAuthenticated();

      allow update: if isAuthenticated() && (
        isAdmin() ||
        dialogId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        resource.data.coachId == request.auth.uid ||
        (resource.data.participantIds != null && request.auth.uid in resource.data.participantIds)
      );

      allow delete: if isAuthenticated() && isAdmin();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // --- Families (both 'families' and 'family_connections') ---
    match /families/{familyId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.primaryParentId == request.auth.uid ||
        (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
        resource.data.inviteCode != null
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.primaryParentId == request.auth.uid ||
        (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
        (request.resource.data.parentIds != null && request.auth.uid in request.resource.data.parentIds)
      );
    }

    match /family_connections/{familyId} {
      allow read, write: if isAuthenticated();
    }

    // --- Notifications ---
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated();
    }

    // --- Class Activities / Newsfeed ---
    match /class_activities/{actId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && isAdmin();
    }

    // --- Activity Logs & Admin Tasks ---
    match /activity_logs/{logId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    match /admin_tasks/{taskId} {
      allow read, write: if isAuthenticated() && isAdmin();
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable logs
    }
  }
}


