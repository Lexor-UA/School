rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for multi-tenancy and authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserData() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return hasUserData() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'superAdmin' ||
        (hasUserData() && getUserData().role == 'superAdmin')
      );
    }

    function isOwner() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.role == 'owner' ||
        (hasUserData() && getUserData().role == 'owner')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isOwner() ||
        request.auth.token.role == 'admin' ||
        (hasUserData() && getUserData().role == 'admin')
      );
    }

    function isCoach() {
      return isAuthenticated() && (
        request.auth.token.role == 'coach' ||
        (hasUserData() && getUserData().role == 'coach')
      );
    }

    function userBranch() {
      return (request.auth.token.branchId != null) ? request.auth.token.branchId :
        ((hasUserData() && getUserData().branchId != null) ? getUserData().branchId : 'kyiv');
    }

    function isStaffForBranch(branchId) {
      return isOwner() || (
        isAdmin() && (userBranch() == branchId || (branchId == null && userBranch() == 'kyiv'))
      );
    }

    // --- Organizations, Branches, and Configurations ---
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();

      match /branches/{branchId} {
        allow read: if isAuthenticated();
        allow write: if isOwner();
      }
    }

    match /branch_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    match /subscription_packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // --- Users (Clients, Coaches, Admins, Owners) ---
    match /users/{userId} {
      // Readable for loginId lookup, profile views, and authentication verification
      allow read: if true;

      allow create: if (
        (isAuthenticated() && (request.auth.uid == userId || isAdmin())) ||
        userId == 'admin' ||
        userId == 'mock_owner' ||
        userId == 'demo_client'
      );

      allow update: if (
        (isAuthenticated() && (request.auth.uid == userId || isStaffForBranch(resource.data.branchId))) ||
        userId == 'admin' ||
        userId == 'mock_owner'
      );

      allow delete: if (
        isOwner() ||
        (isAdmin() && resource.data.role != 'owner' && resource.data.role != 'superAdmin' && resource.data.role != 'admin')
      );
    }

    // --- Children Profiles ---
    match /children/{childId} {
      allow read, write: if isAuthenticated();
    }

    // --- Schedule & Group Classes ---
    match /classes/{classId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || isStaffForBranch(request.resource.data.branchId));
      allow delete: if isAuthenticated() && (isAdmin() || isStaffForBranch(resource.data.branchId));
      allow update: if isAuthenticated() || true;
    }

    // --- Subscriptions ---
    match /subscriptions/{subId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isAdmin() || isStaffForBranch(request.resource.data.branchId));
      allow delete: if isAuthenticated() && (isAdmin() || isStaffForBranch(resource.data.branchId));
      allow update: if isAuthenticated();
    }

    // --- Chat Dialogs & Messages ---
    match /chats/{dialogId} {
      allow read, write: if isAuthenticated() || true;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated() || true;
      }
    }

    // --- Families (both 'families' and 'family_connections') ---
    match /families/{familyId} {
      allow read, write: if isAuthenticated();
    }

    match /family_connections/{familyId} {
      allow read, write: if isAuthenticated();
    }

    // --- Notifications ---
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // --- Class Activities / Newsfeed ---
    match /class_activities/{actId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // --- Activity Logs & Admin Tasks ---
    match /activity_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /admin_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable logs
    }
  }
}

